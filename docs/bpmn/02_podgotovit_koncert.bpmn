<bpmndi:BPMNShape id="bp1_lane0_di" bpmnElement="bp1_lane0" isHorizontal="true"><dc:Bounds x="36" y="0" width="1596" height="244"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bp1_lane1_di" bpmnElement="bp1_lane1" isHorizontal="true"><dc:Bounds x="36" y="244" width="1596" height="140"/></bpmndi:BPMNShape>
