<bpmndi:BPMNShape id="a5_di" bpmnElement="a5"><dc:Bounds x="1025" y="29" width="162" height="82"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g_di" bpmnElement="g"><dc:Bounds x="1236" y="46" width="48" height="48"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="er_di" bpmnElement="er"><dc:Bounds x="1395" y="155" width="38" height="38"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="a6_di" bpmnElement="a6"><dc:Bounds x="1333" y="29" width="162" height="82"/></bpmndi:BPMNShape>
