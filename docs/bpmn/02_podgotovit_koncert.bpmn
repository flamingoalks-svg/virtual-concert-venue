<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="bp1_defs" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="bp1_collab"><bpmn:participant id="bp1_pool" name="Подготовить концерт" processRef="bp1_process"/>
</bpmn:collaboration>
<bpmn:process id="bp1_process" isExecutable="false">
<bpmn:laneSet id="bp1_ls">
<bpmn:lane id="bp1_lane0" name="Промоутер">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pg2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g</bpmn:flowNodeRef>
<bpmn:flowNodeRef>er</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="bp1_lane1" name="Артист">
<bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="bp1_lane2" name="Администратор площадки">
<bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Концерт запланирован"><bpmn:outgoing>bp1_f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="a1" name="Выбрать артиста, дату и город"><bpmn:incoming>bp1_f0</bpmn:incoming><bpmn:outgoing>bp1_f1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="a2" name="Оценить спрос и бюджет"><bpmn:incoming>bp1_f1</bpmn:incoming><bpmn:outgoing>bp1_f2</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="pg1" name=""><bpmn:incoming>bp1_f2</bpmn:incoming><bpmn:outgoing>bp1_f3</bpmn:outgoing><bpmn:outgoing>bp1_f4</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:manualTask id="a3" name="Согласовать договор выступления"><bpmn:incoming>bp1_f3</bpmn:incoming><bpmn:outgoing>bp1_f5</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="a4" name="Заключить договор аренды зала"><bpmn:incoming>bp1_f4</bpmn:incoming><bpmn:outgoing>bp1_f6</bpmn:outgoing><bpmn:dataOutputAssociation id="a4_doc_da"><bpmn:targetRef>doc</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:manualTask>
<bpmn:parallelGateway id="pg2" name=""><bpmn:incoming>bp1_f5</bpmn:incoming><bpmn:incoming>bp1_f6</bpmn:incoming><bpmn:outgoing>bp1_f7</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:businessRuleTask id="a5" name="Оценить риск отмены"><bpmn:incoming>bp1_f7</bpmn:incoming><bpmn:outgoing>bp1_f8</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="g" name="Риск приемлем?"><bpmn:incoming>bp1_f8</bpmn:incoming><bpmn:outgoing>bp1_f9</bpmn:outgoing><bpmn:outgoing>bp1_f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="er" name="Концерт отклонён"><bpmn:incoming>bp1_f9</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="a6" name="Разместить карточку мероприятия"><bpmn:incoming>bp1_f10</bpmn:incoming><bpmn:outgoing>bp1_f11</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="ok" name="Концерт подготовлен"><bpmn:incoming>bp1_f11</bpmn:incoming></bpmn:endEvent>
<bpmn:dataObjectReference id="doc" name="Договор аренды" dataObjectRef="doc_do"/><bpmn:dataObject id="doc_do"/>
<bpmn:sequenceFlow id="bp1_f0" name="" sourceRef="s" targetRef="a1"/>
<bpmn:sequenceFlow id="bp1_f1" name="" sourceRef="a1" targetRef="a2"/>
<bpmn:sequenceFlow id="bp1_f2" name="" sourceRef="a2" targetRef="pg1"/>
<bpmn:sequenceFlow id="bp1_f3" name="" sourceRef="pg1" targetRef="a3"/>
<bpmn:sequenceFlow id="bp1_f4" name="" sourceRef="pg1" targetRef="a4"/>
<bpmn:sequenceFlow id="bp1_f5" name="" sourceRef="a3" targetRef="pg2"/>
<bpmn:sequenceFlow id="bp1_f6" name="" sourceRef="a4" targetRef="pg2"/>
<bpmn:sequenceFlow id="bp1_f7" name="" sourceRef="pg2" targetRef="a5"/>
<bpmn:sequenceFlow id="bp1_f8" name="" sourceRef="a5" targetRef="g"/>
<bpmn:sequenceFlow id="bp1_f9" name="Нет" sourceRef="g" targetRef="er"/>
<bpmn:sequenceFlow id="bp1_f10" name="Да" sourceRef="g" targetRef="a6"/>
<bpmn:sequenceFlow id="bp1_f11" name="" sourceRef="a6" targetRef="ok"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="bp1_d"><bpmndi:BPMNPlane id="bp1_pl" bpmnElement="bp1_collab">
