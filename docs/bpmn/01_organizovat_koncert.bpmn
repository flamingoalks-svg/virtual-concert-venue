<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="bp0_defs" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="bp0_collab"><bpmn:participant id="bp0_pool" name="Организовать концерт" processRef="bp0_process"/>
<bpmn:participant id="bp0_ext" name="Зритель"/>
<bpmn:messageFlow id="bp0_m0" name="Электронный билет" sourceRef="t1" targetRef="bp0_ext"/>
<bpmn:messageFlow id="bp0_m1" name="Заявка на возврат" sourceRef="bp0_ext" targetRef="t4"/>
<bpmn:messageFlow id="bp0_m2" name="Возврат" sourceRef="t2" targetRef="bp0_ext"/>
</bpmn:collaboration>
<bpmn:process id="bp0_process" isExecutable="false">
<bpmn:laneSet id="bp0_ls">
<bpmn:lane id="bp0_lane0" name="Менеджер билетного сервиса">
<bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pg2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="bp0_lane1" name="Промоутер">
<bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="bp0_lane2" name="Администратор площадки">
<bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Решение о концерте принято"><bpmn:outgoing>bp0_f0</bpmn:outgoing><bpmn:conditionalEventDefinition id="s0_cd"><bpmn:condition xsi:type="bpmn:tFormalExpression">Решение о концерте принято</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:subProcess id="p1" name="Подготовить концерт"><bpmn:incoming>bp0_f0</bpmn:incoming><bpmn:outgoing>bp0_f1</bpmn:outgoing></bpmn:subProcess>
<bpmn:exclusiveGateway id="g1" name="Концерт подготовлен?"><bpmn:incoming>bp0_f1</bpmn:incoming><bpmn:outgoing>bp0_f2</bpmn:outgoing><bpmn:outgoing>bp0_f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e1" name="Концерт отклонён"><bpmn:incoming>bp0_f2</bpmn:incoming></bpmn:endEvent>
<bpmn:parallelGateway id="pg1" name=""><bpmn:incoming>bp0_f3</bpmn:incoming><bpmn:outgoing>bp0_f4</bpmn:outgoing><bpmn:outgoing>bp0_f5</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="t1" name="Продать билеты"><bpmn:incoming>bp0_f4</bpmn:incoming><bpmn:outgoing>bp0_f6</bpmn:outgoing><bpmn:dataOutputAssociation id="t1_ds_da"><bpmn:targetRef>ds</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:userTask id="t4" name="Обработать заявки на возврат (А2)"><bpmn:incoming>bp0_f5</bpmn:incoming><bpmn:outgoing>bp0_f7</bpmn:outgoing><bpmn:dataOutputAssociation id="t4_ds_da"><bpmn:targetRef>ds</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:dataStoreReference id="ds" name="База продаж билетного сервиса"/>
<bpmn:parallelGateway id="pg2" name=""><bpmn:incoming>bp0_f6</bpmn:incoming><bpmn:incoming>bp0_f7</bpmn:incoming><bpmn:outgoing>bp0_f8</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:exclusiveGateway id="g2" name="Концерт отменён?"><bpmn:incoming>bp0_f8</bpmn:incoming><bpmn:outgoing>bp0_f9</bpmn:outgoing><bpmn:outgoing>bp0_f11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="t2" name="Вернуть стоимость билетов (А2)"><bpmn:incoming>bp0_f9</bpmn:incoming><bpmn:outgoing>bp0_f10</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="e2" name="Стоимость билетов возвращена"><bpmn:incoming>bp0_f10</bpmn:incoming></bpmn:endEvent>
<bpmn:subProcess id="p2" name="Провести концерт (А1, А3, А4)"><bpmn:incoming>bp0_f11</bpmn:incoming><bpmn:outgoing>bp0_f12</bpmn:outgoing></bpmn:subProcess>
<bpmn:manualTask id="t3" name="Рассчитаться с артистом и подрядчиками"><bpmn:incoming>bp0_f12</bpmn:incoming><bpmn:outgoing>bp0_f13</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="t5" name="Проанализировать продажи и посещаемость"><bpmn:incoming>bp0_f13</bpmn:incoming><bpmn:outgoing>bp0_f14</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e3" name="Концерт проведён"><bpmn:incoming>bp0_f14</bpmn:incoming></bpmn:endEvent>
