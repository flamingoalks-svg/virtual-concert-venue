<bpmn:sequenceFlow id="bp0_f10" name="" sourceRef="t2" targetRef="e2"/>
<bpmn:sequenceFlow id="bp0_f11" name="Нет" sourceRef="g2" targetRef="p2"/>
<bpmn:sequenceFlow id="bp0_f12" name="" sourceRef="p2" targetRef="t3"/>
<bpmn:sequenceFlow id="bp0_f13" name="" sourceRef="t3" targetRef="t5"/>
<bpmn:sequenceFlow id="bp0_f14" name="" sourceRef="t5" targetRef="e3"/>
</bpmn:process>
